{
  "name": "@mazerila/booking-kit",
  "version": "0.1.0",
  "description": "Reusable appointment booking module for service-provider websites (widget, admin, Firebase backend).",
  "type": "module",
  "sideEffects": [
    "*.css"
  ],
  "files": [
    "dist",
    "src",
    "template",
    "scripts/setup-client.ts"
  ],
  "exports": {
    "./core": {
      "types": "./dist/core/index.d.ts",
      "default": "./dist/core/index.js"
    },
    "./react": {
      "types": "./dist/react/index.d.ts",
      "default": "./dist/react/index.js"
    },
    "./admin": {
      "types": "./dist/admin/index.d.ts",
      "default": "./dist/admin/index.js"
    },
    "./functions": {
      "types": "./dist/functions/index.d.ts",
      "default": "./dist/functions/index.js"
    },
    "./styles.css": "./dist/styles/booking.css",
    "./admin.css": "./dist/styles/admin.css"
  },
  "scripts": {
    "build": "rm -rf dist && tsc -p tsconfig.build.json && mkdir -p dist/styles && cp src/styles/*.css dist/styles/",
    "prepare": "npm run build",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:emulator": "firebase emulators:exec --project demo-booking --only firestore,auth \"vitest run --config vitest.emulator.config.ts\"",
    "demo": "npm --prefix demo run dev"
  },
  "dependencies": {
    "zod": "^4.6.7"
  },
  "peerDependencies": {
    "firebase": ">=12",
    "firebase-admin": ">=13",
    "firebase-functions": ">=6",
    "react": ">=19",
    "react-dom": ">=19"
  },
  "peerDependenciesMeta": {
    "firebase": {
      "optional": true
    },
    "firebase-admin": {
      "optional": true
    },
    "firebase-functions": {
      "optional": true
    },
    "react": {
      "optional": true
    },
    "react-dom": {
      "optional": true
    }
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "^6.0.0",
    "@types/node": "^22.20.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "firebase": "^13.0.0",
    "firebase-admin": "^14.5.0",
    "firebase-functions": "^7.4.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "vitest": "^5.0.5"
  },
  "repository": {
    "type": "git",
    "url": "git+ssh://git@github.com/mazerila/booking-kit.git"
  },
  "private": true
}
